{
  "provider": "github",
  "defaultBaseBranch": "main",
  "repo": "0oWoodenDooro0/LolDraftAi",
  "branchPrefix": "feature/",
  "operator": "Antigravity",
  "verify": [
    "./gradlew test"
  ],
  "hooks": {
    "pre-commit": [],
    "pre-submit-pr": [
      "./gradlew test"
    ],
    "pre-complete-review": [
      "./gradlew test"
    ]
  },
  "workflows": {
    "build": {
      "description": "Build Kotlin project artifacts",
      "steps": [
        "./gradlew build"
      ]
    },
    "test": {
      "description": "Run Kotlin unit test suite",
      "steps": [
        "./gradlew test"
      ]
    }
  },
  "workflow": {
    "mergeMethod": "squash",
    "deleteBranchOnMerge": true,
    "requireVerification": true,
    "checkoutBaseOnComplete": true,
    "checkoutBaseOnSubmitPr": true,
    "requestColumn": "REQUEST",
    "doneColumn": "DONE",
    "reviewColumn": "REVIEW"
  }
}
